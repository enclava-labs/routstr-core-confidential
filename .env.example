# Core Configuration
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=your-upstream-api-key

# ADMIN_PASSWORD=secure-admin-password

# Database
# DATABASE_URL=sqlite+aiosqlite:///keys.db

# Node Information
# NAME=My Routstr Node
# DESCRIPTION=Fast AI API access with Bitcoin payments
# NSEC=nsec1...
# HTTP_URL=https://api.mynode.com
# ONION_URL=http://mynode.onion (auto fetched from compose)
# RELAYS="wss://relay.damus.io,wss://relay.nostr.band,wss://eden.nostr.land,wss://relay.routstr.com"
# ENABLE_ANALYTICS_SHARING=true
# CASHU_MINTS="https://mint.minibits.cash/Bitcoin,https://mint.cubabitcoin.org,https://ecashmint.otrta.me"
# RECEIVE_LN_ADDRESS=

# Custom Pricing Configuration
# MODEL_BASED_PRICING=true
# COST_PER_REQUEST=1
# COST_PER_1K_INPUT_TOKENS=0
# COST_PER_1K_OUTPUT_TOKENS=0
# EXCHANGE_FEE=1.005
# UPSTREAM_PROVIDER_FEE=1.05

# Network Configuration
# CORS_ORIGINS=*
# TOR_PROXY_URL=socks5://127.0.0.1:9050

# Logging
# LOG_LEVEL=INFO
# ENABLE_CONSOLE_LOGGING=true

# Custom Model Management
# BASE_URL=https://openrouter.ai/api/v1
# MODELS_PATH=models.json
# SOURCE=

# Confidential Provider Credentials
# TINFOIL_API_KEY=your-tinfoil-api-key
# PPQ_API_KEY=your-ppq-api-key
# PPQ_PRIVATE_API_KEY=your-ppq-private-api-key
# PPQ_PRIVATE_BASE_URL=https://api.ppq.ai/private/v1
# PRIVATEMODE_API_KEY=your-privatemode-api-key
# PRIVATEMODE_PROXY_URL=http://127.0.0.1:18081/v1

# Confidential Routing Deployment
# CONFIDENTIAL_ROUTING_MODE=required
# ROUTSTR_TEE_CLIENT_CONFIDENTIALITY_BOUNDARY=attested-tls-termination
# ROUTSTR_TEE_ATTESTATION_REQUIRED=true
# ROUTSTR_TEE_ATTESTATION_DOCUMENT_FORMAT=tdx_quote
# ROUTSTR_TEE_PUBLIC_KEY_PATH=/app/data/routstr-tee-public-key.pem
# ROUTSTR_TEE_HPKE_KEY_CONFIG_PATH=/app/data/routstr-hpke-key-config.b64
# ROUTSTR_TEE_ATTESTED_TLS_PUBLIC_KEY_DIGEST=sha256:...
# ROUTSTR_TEE_VERIFIER_COMMAND=build/confidential-verifiers/routstr-tee-go-verifier
# ROUTSTR_TEE_VERIFIER_COMMAND_DIGEST=sha256:...
# ROUTSTR_TEE_ATTESTATION_COMMAND=build/confidential-verifiers/routstr-tee-attest-go
# ROUTSTR_TEE_ATTESTATION_COMMAND_DIGEST=sha256:...
# See examples/confidential-routing/routstr-tee-environment.example for a full template.
# ROUTSTR_TEE_VERIFIER_POLICY_JSON={}

# UI Configuration (for Next.js frontend)
# These variables are prefixed with NEXT_PUBLIC_ to be accessible in the browser
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
